{
  "name": "moolnivashi-ai",
  "version": "1.0.0",
  "description": "Moolnivashi AI: Autonomous 14-Chain Web3 + AI Operating Protocol bridging Bitcoin, Ethereum, Solana, Polkadot, Dogecoin, Cosmos & more via ICP Chain Fusion, x402 & Post-Quantum Cryptography",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "node --test tests/*.test.js",
    "test:adapters": "node --test tests/adapters.test.js",
    "test:router": "node --test tests/router.test.js",
    "test:x402": "node --test tests/x402.test.js",
    "mission": "node scripts/mission.js",
    "mission:testnet": "node scripts/mission.js --network testnet",
    "mission:mainnet": "node scripts/mission.js --network mainnet",
    "mission:finisher": "node scripts/mission-finisher.js --mode baseline",
    "mission:finisher:testnet": "node scripts/mission-finisher.js --mode testnet",
    "mission:finisher:mainnet": "node scripts/mission-finisher.js --mode mainnet",
    "master:green": "node scripts/master-green.js",
    "master:green:testnet": "node scripts/master-green.js --mode testnet",
    "master:green:mainnet": "node scripts/master-green.js --mode mainnet",
    "master": "node scripts/master-runner.js",
    "master:strict": "node scripts/master-runner.js --strict",
    "deploy:mainnet": "bash scripts/deploy-mainnet.sh",
    "verify:pqc": "node scripts/pqc-verifier.js",
    "verify:x402": "node scripts/x402-verifier.js",
    "production:finisher": "node scripts/production-finisher.js"
  },
  "keywords": [
    "icp",
    "chain-fusion",
    "bitcoin",
    "ethereum",
    "solana",
    "dogecoin",
    "polkadot",
    "stellar",
    "cross-chain",
    "x402",
    "pqc",
    "ai-agents",
    "web4"
  ],
  "author": "Moolnivashi AI Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@noble/post-quantum": "^0.7.1"
  }
}
